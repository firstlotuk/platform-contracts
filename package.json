{
  "name": "@firstlot/platform-contracts",
  "version": "0.28.0",
  "description": "FirstLot Tax Platform \u2014 shared cross-boundary contracts for the filing suite",
  "private": true,
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/filing-contribution-pack-node.d.ts",
      "require": "./dist/filing-contribution-pack-node.js",
      "default": "./dist/filing-contribution-pack-node.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "require": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "generate:contracts": "node scripts/generate-contribution-pack.mjs",
    "check:generated": "node scripts/generate-contribution-pack.mjs --check",
    "build": "npm run check:generated && tsc",
    "typecheck": "npm run check:generated && tsc --noEmit",
    "test": "npm run check:generated && jest",
    "ci:test": "npm run build && npm run typecheck && npm test -- --runInBand",
    "prepare": "npm run generate:contracts && tsc"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "json-canonicalize": "2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "jest": "^29",
    "jest-environment-node": "^29",
    "json-schema-to-typescript": "^15.0.4",
    "ts-jest": "^29",
    "typescript": "^5.9.3"
  }
}
